# ==============================================================================
# ManageX Environment Variable Specification & Template
# ==============================================================================
# SECURITY INVARIANT:
# Never commit actual secret values. Copy this file to .env for local development.
# ==============================================================================

# Backend Runtime Configuration
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
# In Phase 1, the backend boots without requiring an active DB connection,
# but validates the environment variable syntax.
DATABASE_URL=postgresql://managex_app:placeholder_password@localhost:5432/managex

# Security & Sessions (64+ character random hex string recommended for production)
SESSION_SECRET=development_session_secret_change_me_to_a_long_random_string_in_production
CSRF_SECRET=development_csrf_secret_change_me_to_a_long_random_string_in_production

# Email Delivery (Optional in development - falls back to safe console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ManageX <notifications@managex.local>

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=development
