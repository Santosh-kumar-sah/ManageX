# ==============================================================================
# ManageX Environment Variable Specification & Template
# ==============================================================================
# SECURITY INVARIANT:
# Never commit actual secret values. Copy this file to .env for local development.
# ==============================================================================

# Backend Runtime Configuration
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
# In Phase 1, the backend boots without requiring an active DB connection,
# but validates the environment variable syntax.
DATABASE_URL=postgresql://managex_app:placeholder_password@localhost:5432/managex

# Security & Sessions (64+ character random hex string recommended for production)
SESSION_SECRET=development_session_secret_change_me_to_a_long_random_string_in_production
CSRF_SECRET=development_csrf_secret_change_me_to_a_long_random_string_in_production

# Email Delivery (Optional in development - falls back to safe console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ManageX <notifications@managex.local>

# Google OAuth 2.0 Integration (Phase 1B — Google Meet & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# Token Encryption (AES-256-GCM — 64-character hex string / 32 bytes)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# OpenRouter AI Integration (Phase 01 — Shared AI Foundation)
AI_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=30000
AI_DEFAULT_MONTHLY_TOKEN_QUOTA=500000

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=development
