{
  "name": "managex",
  "version": "1.0.0",
  "private": true,
  "description": "ManageX - Multi-Tenant Modular Organisation Management SaaS Platform",
  "type": "module",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "migrate": "node database/migrate.js",
    "seed": "node backend/scripts/seed_demo.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
